---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContextualConsultPage from '../components/ContextualConsultPage.astro';
import { getConsultConfig } from '../data/consultFormConfigs';

const config = getConsultConfig('commercial-survey');
---

<BaseLayout
  title={config.seoTitle}
  description={config.seoDescription}
  activePage={config.activePage}
  headerScrolled={false}
>
  <ContextualConsultPage config={config} />
</BaseLayout>
