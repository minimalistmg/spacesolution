---
import MenuIcon from '../components/MenuIcon.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import FloatingContactForm from '../components/FloatingContactForm.astro';
import FaqSection from '../components/FaqSection.astro';
import DummyVideoBlock from '../components/DummyVideoBlock.astro';
import { SITE } from '../data/site';
import { resolveConnectFormDefaults } from '../data/connectFormInterests';
import '../styles/home-3d-consult.css';
import '../styles/contact-page.css';

const pathname = Astro.url.pathname.replace(/\.html$/, '') || '/';
const contactFormDefaults = resolveConnectFormDefaults(
  'home',
  pathname,
  Astro.url.searchParams.get('interest'),
);
const whatsappHref = `https://wa.me/${SITE.phones[0].replace('+', '')}`;
const phoneLabel = SITE.phones[0].replace(/^(\+91)(\d{5})(\d{5})$/, '$1 $2 $3');

const phoneDisplays = [
  { tel: SITE.phones[0], label: '+91 63645 64563' },
  { tel: SITE.phones[1], label: '+91 98452 41484' },
];

const fullAddress = `${SITE.address.streetAddress}, ${SITE.address.addressLocality}, ${SITE.address.addressRegion} ${SITE.address.postalCode}`;
const mapDestination = `Space Solution, 90, Kalidasa Rd, ${SITE.address.addressLocality}, ${SITE.address.addressRegion} ${SITE.address.postalCode}`;

const contactSteps = [
  {
    title: 'Share your project',
    description: 'Home, commercial, or hospitality — plus a number we can reach you on.',
  },
  {
    title: 'We call you back',
    description: 'Within one business day we clarify scope, timeline, and the best next step.',
  },
  {
    title: 'Visit or start design',
    description: 'Come to the Kalidasa Road studio, or we begin from plans and a 3D consult.',
  },
];

const bringList = [
  'Floor plans or approximate room sizes (photos on your phone are fine)',
  'A rough budget range and preferred move-in or opening timeline',
  'Reference images for style — light, storage, and materials you like',
  'Notes on must-haves: kitchen layout, wardrobe count, workstation count, or brand colours',
];

const visitTips = [
  {
    title: 'Experience centre hours',
    description: 'Visit by appointment so a designer can walk you through materials and sample finishes without rush.',
  },
  {
    title: 'Free consultation',
    description: 'We discuss scope, ballpark cost drivers, and whether a turnkey or phased approach fits your project.',
  },
  {
    title: 'What happens next',
    description: 'If we are a fit, we schedule a site visit or plan review and share a clear path to 3D design and quotation.',
  },
];

const faqs = [
  {
    question: 'How quickly will someone respond to my enquiry?',
    answer:
      'We aim to respond within one business day. For faster help, call or WhatsApp during working hours and mention whether your project is residential or commercial.',
  },
  {
    question: 'Do I need a site visit before getting a quote?',
    answer:
      'A site visit or accurate floor plan makes estimates far more reliable. For early planning we can start with plans and photos, then confirm measurements before final pricing.',
  },
  {
    question: 'Can I book a consultation without committing to a project?',
    answer:
      'Yes. Consultations are meant to clarify scope, timeline, and budget fit. There is no obligation to proceed until you approve a design and quotation.',
  },
  {
    question: 'Where is Space Solution located in Mysuru?',
    answer: `Our experience centre is at ${fullAddress}. Use the map on this page or open directions in Google Maps before you visit.`,
  },
];
---

<BaseLayout
  title="Contact Space Solution Mysuru | Book a Free Interior Consultation"
  description={`Contact Space Solution in Mysuru for home and commercial interiors. Call ${phoneDisplays[0].label}, email ${SITE.email}, or visit our Kalidasa Road experience centre for a free consultation.`}
  headerScrolled={false}
>
  <section class="h3d-page h3d-page--contact">
    <div class="container h3d-panes">
      <div class="h3d-pane h3d-pane--copy">
        <nav class="h3d-breadcrumb" aria-label="Breadcrumb">
          <a href="/">Space Solution</a> / Contact
        </nav>
        <p class="h3d-kicker">Contact</p>
        <h1 class="h3d-title">
          Let’s talk <em>in person</em>
        </h1>
        <p class="h3d-lead">
          Book a free consultation for home or commercial interiors in Mysuru — clear next steps on design, cost, and
          timeline.
        </p>
        <ol class="h3d-steps">
          {
            contactSteps.map((step, index) => (
              <li class="h3d-step">
                <span class="h3d-step-num">{index + 1}</span>
                <div>
                  <h3>{step.title}</h3>
                  <p>{step.description}</p>
                </div>
              </li>
            ))
          }
        </ol>
        <div class="h3d-contact-row">
          <a href={`tel:${SITE.phones[0]}`} class="btn h3d-btn-outline">
            <MenuIcon name="phone" />
            {phoneLabel}
          </a>
          <a href={whatsappHref} class="btn h3d-btn-outline" target="_blank" rel="noopener noreferrer">
            <MenuIcon name="whatsapp-logo" />
            WhatsApp
          </a>
        </div>
      </div>

      <div class="h3d-pane h3d-pane--form">
        <div class="h3d-form-card">
          <FloatingContactForm
            formId="contact-form"
            defaults={contactFormDefaults}
            whatsappHref={whatsappHref}
          />
        </div>
      </div>
    </div>
  </section>

  <section class="contact-visit" aria-labelledby="contact-map-heading">
    <div class="contact-visit-copy">
      <h2 class="contact-visit-title" id="contact-map-heading">Visit our studio</h2>
      <form
        class="contact-directions-form"
        data-contact-directions
        data-destination={mapDestination}
        data-fallback={SITE.mapDirectionsUrl}
      >
        <label class="sr-only" for="contact-origin">Starting from</label>
        <input
          id="contact-origin"
          type="text"
          name="origin"
          autocomplete="street-address"
          placeholder="Starting from — area or address"
        />
        <button type="submit" class="btn btn-gold-filled">Get directions</button>
      </form>

      <ul class="contact-visit-tips">
        {
          visitTips.map((tip) => (
            <li class="contact-visit-tip">
              <span class="contact-visit-tip-title">{tip.title}</span>
              <span class="contact-visit-tip-text">{tip.description}</span>
            </li>
          ))
        }
      </ul>
    </div>
    <div class="contact-visit-map">
      <iframe
        src={SITE.mapEmbedUrl}
        title="Space Solution location on Google Maps"
        allowfullscreen
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
      ></iframe>
    </div>
  </section>

  <section class="service-block">
    <div class="container">
      <p class="section-label fade-up">Before you visit</p>
      <h2 class="section-title fade-up">What to bring to your consultation</h2>
      <p class="section-desc fade-up content-body">
        You do not need a finished brief. A few practical details help us give useful guidance in the first meeting —
        whether you are planning a modular kitchen, a full home, or a commercial fitout.
      </p>
      <ul class="feature-list fade-up">
        {bringList.map((item) => <li>{item}</li>)}
      </ul>
      <p class="content-body fade-up" style="margin-top: 28px;">
        Prefer to talk first? Call{' '}
        <a href={`tel:${SITE.phones[0]}`}>{phoneDisplays[0].label}</a>
        {' '}or email{' '}
        <a href={`mailto:${SITE.email}`}>{SITE.email}</a>.
      </p>
    </div>
  </section>

  <DummyVideoBlock
    eyebrow="Studio"
    title="Get a feel for how we work"
    description="A short look at how Space Solution moves from conversation to design, factory production, and finished interiors in Mysuru."
  />

  <FaqSection
    title="Contact & visit FAQs"
    description="Helpful details before you call, write, or stop by our Mysuru experience centre."
    items={faqs}
  />

  <script is:inline>
    (function () {
      var form = document.querySelector('[data-contact-directions]');
      if (!form) return;
      form.addEventListener('submit', function (event) {
        event.preventDefault();
        var originInput = form.querySelector('[name="origin"]');
        var origin = originInput && originInput.value ? originInput.value.trim() : '';
        var destination = form.getAttribute('data-destination') || '';
        var fallback = form.getAttribute('data-fallback') || '';
        var url = fallback;
        if (origin && destination) {
          url =
            'https://www.google.com/maps/dir/?api=1&origin=' +
            encodeURIComponent(origin) +
            '&destination=' +
            encodeURIComponent(destination);
        }
        if (url) window.open(url, '_blank', 'noopener,noreferrer');
      });
    })();
  </script>
</BaseLayout>
