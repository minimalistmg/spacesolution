---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectDetailSection from '../../components/ProjectDetailSection.astro';
import FaqSection from '../../components/FaqSection.astro';
import CtaSection from '../../components/CtaSection.astro';
import {
  getProjectBySlug,
  getProjectNeighbors,
  projects,
} from '../../data/projects';

export function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
  }));
}

const { slug } = Astro.params;
const project = getProjectBySlug(slug!);

if (!project) {
  return Astro.redirect('/portfolio');
}

const { next } = getProjectNeighbors(project.slug);
---

<BaseLayout
  title={`${project.title} | Projects | Space Solution`}
  description={project.headline}
  headerScrolled={false}
>
  <ProjectDetailSection project={project} nextProject={next} />

  {
    project.faqs && project.faqs.length > 0 && (
      <FaqSection
        title="Project questions"
        description="How this fit-out was scoped, built, and how a similar brief would start."
        items={project.faqs}
      />
    )
  }

  <CtaSection />
</BaseLayout>
