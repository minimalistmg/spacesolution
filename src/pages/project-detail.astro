---
/**
 * Legacy URL kept for old bookmarks and homepage gallery links.
 * Serves a proper projects gateway (not an empty redirect stub).
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import CtaSection from '../components/CtaSection.astro';
import ImageGallery from '../components/ImageGallery.astro';
import DummyVideoBlock from '../components/DummyVideoBlock.astro';
import { projects } from '../data/projects';
import { heroImages, roomImages, projectImages } from '../data/images';

const featured = projects.slice(0, 6);
---

<BaseLayout
  title="Project Details & Case Studies | Space Solutions Mysuru"
  description="Browse Space Solutions project case studies — residential, commercial, hospitality, and wellness interiors delivered across Mysuru and Karnataka."
  activePage="studio"
  headerScrolled={false}
>
  <PageHero
    breadcrumb={'<a href="/">Home</a> <span class="breadcrumb-sep">/</span> Project detail'}
    title="Project case studies"
    description="Explore completed interiors, then open any project for scope, timeline, and gallery detail."
    image={heroImages.residential}
  />

  <section class="page-content">
    <div class="container content-prose">
      <p class="section-label fade-up">Portfolio gateway</p>
      <h2 class="section-title fade-up">Every project, one clear story</h2>
      <p class="content-body fade-up">
        This page replaces an older project-detail URL. Choose a case study below, or visit the full
        filterable portfolio for residential, commercial, hospitality, and wellness work.
      </p>
      <p class="fade-up" style="margin-top: 24px;">
        <a href="/portfolio" class="btn btn-gold-filled">View full portfolio</a>
      </p>
    </div>
  </section>

  <section class="page-content section-compact-top">
    <div class="container">
      <h2 class="section-heading-lg fade-up">Featured projects</h2>
      <ul class="service-related-links fade-up">
        {
          featured.map((project) => (
            <li>
              <a href={project.href}>
                {project.title} — {project.location}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <ImageGallery
    title="Spaces we deliver"
    description="Homes, workplaces, clinics, cafés, and hospitality interiors — photographed in a light, practical palette."
    items={[
      { src: projectImages.apartment, alt: 'Residential living interior', caption: 'Residential' },
      { src: roomImages.office, alt: 'Office workspace', caption: 'Commercial' },
      { src: roomImages.cafe, alt: 'Café dining interior', caption: 'Hospitality' },
      { src: roomImages.clinic, alt: 'Clinic reception', caption: 'Healthcare' },
    ]}
  />

  <DummyVideoBlock />
  <CtaSection />
</BaseLayout>
