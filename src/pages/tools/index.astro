---
import Icon from '../../components/Icon.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import CtaSection from '../../components/CtaSection.astro';
import DummyVideoBlock from '../../components/DummyVideoBlock.astro';
import FaqSection from '../../components/FaqSection.astro';
import { heroImages } from '../../data/images';
import { toolPages, toolsHubIntro } from '../../data/tools';
import { toolSegments } from '../../data/toolHeroes';

const toolsBySlug = Object.fromEntries(toolPages.map((tool) => [tool.slug, tool]));

const hubFaqs = [
  {
    question: 'Are these tool estimates a final quote?',
    answer:
      'No. Every calculator gives an indicative planning range. Your Space Solutions quote follows a site measure, drawings, and confirmed materials.',
  },
  {
    question: 'Can I use the tools for projects outside Mysuru?',
    answer:
      'Yes for rough planning. Rates and lead times are calibrated for Mysuru and Karnataka work; other cities may differ once we review logistics.',
  },
  {
    question: 'Which tool should I start with?',
    answer:
      'Home projects usually begin with the kitchen cost estimator or home budget calculator. Offices start with the office space calculator. Hospitality teams often use seating and opening-day tools together.',
  },
  {
    question: 'What happens after I get a number?',
    answer:
      'Book a free 3D consultation. Bring your approximate carpet area, photos, and must-have list — we will turn the estimate into a clear scope and timeline.',
  },
];
---

<BaseLayout
  title="Free Interior Planning Tools in Mysuru | Space Solutions"
  description="Free kitchen, home, office, institutional, and hospitality planning tools from Space Solutions Mysuru — rough budgets, layouts, and capacity before you book a consultation."
  activePage="studio"
  headerScrolled={false}
>
  <PageHero
    breadcrumb={'<a href="/">Home</a> <span class="breadcrumb-sep">/</span> Tools'}
    title={toolsHubIntro.title}
    description={toolsHubIntro.heroDescription}
    image={heroImages.residential}
  />

  <section class="page-content tools-hub-intro">
    <div class="container content-prose fade-up">
      <p class="section-label">Free planning aids</p>
      <h2 class="section-title">Plan with clearer numbers before you commit</h2>
      <p class="content-body">{toolsHubIntro.intro}</p>
      <p class="content-body">{toolsHubIntro.trustLine}</p>
      <p class="content-body">
        All twelve tools below are linked from the Space Solutions header menu. Use them to compare
        scope options, then enquire for a measured proposal from our Mysuru studio and factory.
      </p>
    </div>
  </section>

  {
    toolSegments.map((segment) => (
      <section class="tools-hub" id={`tools-${segment.id}`}>
        <div class="container">
          <p class="section-label fade-up">{segment.title}</p>
          <h2 class="section-heading-lg fade-up">{segment.title} tools</h2>
          <p class="section-desc fade-up">{segment.description}</p>
          <div class="tools-hub-grid">
            {segment.slugs.map((slug) => {
              const tool = toolsBySlug[slug];
              if (!tool) return null;
              return (
                <a href={`/tools/${tool.slug}`} class="tools-hub-card fade-up">
                  <span class="tools-hub-card-eyebrow">{tool.eyebrow}</span>
                  <strong>{tool.title}</strong>
                  <span>{tool.lead}</span>
                  <Icon name="arrow-right" class="tools-hub-card-arrow" />
                </a>
              );
            })}
          </div>
        </div>
      </section>
    ))
  }

  <FaqSection
    items={hubFaqs}
    title="About these planning tools"
    description="Quick answers before you pick a calculator."
  />

  <DummyVideoBlock
    title="From estimate to executed interior"
    description="See how Space Solutions moves from planning numbers to factory production and site handover."
  />

  <CtaSection />
</BaseLayout>
