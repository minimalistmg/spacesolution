---
import BaseLayout from '../layouts/BaseLayout.astro';
import MenuIcon from './MenuIcon.astro';
import type { ToolPage } from '../data/tools';
import { getToolExperience } from '../data/toolPageExperience';

interface Props {
  page: ToolPage;
}

const { page } = Astro.props;
const calc = page.calculator;
const experience = getToolExperience(page.slug);
const relatedTools = page.related.filter(
  (link) => link.href.startsWith('/tools/') && link.href !== `/tools/${page.slug}`,
);
const companionTool = relatedTools[0] ?? { label: 'All Planning Tools', href: '/tools' };
const finishLabels: Record<number, string> = {
  1: 'Practical',
  2: 'Balanced',
  3: 'Premium',
};
---

<BaseLayout
  title={page.seoTitle}
  description={page.metaDescription}
  headerScrolled={false}
  hideSocial={true}
>
  <section class="tool-calc-section tool-screen-section" aria-labelledby="tool-calc-heading">
    <div class="container">
      <div
        class="tool-calc fade-up"
        id="tool-calc"
        data-calc-type={calc.type}
        data-formula={calc.type === 'range-estimate' ? calc.formula : undefined}
        data-default-days={calc.type === 'countdown' ? String(calc.defaultDays) : undefined}
      >
        <div class="tool-calc-header">
          <p class="section-label">{page.eyebrow}</p>
          <h1 id="tool-calc-heading">{page.title}</h1>
          <p class="tool-calc-intro">{page.lead}</p>
          <div class="tool-calc-header-actions">
            <p>Adjust the inputs for a rough planning result.</p>
            <button type="button" class="tool-reset" data-tool-reset>Reset inputs</button>
          </div>
        </div>

        {
          calc.type === 'range-estimate' && (
            <div class="tool-calc-body">
              <div class="tool-fields">
                {calc.fields.map((field) => (
                  <div class="tool-field">
                    <div class="tool-field-top">
                      <label for={`tool-field-${field.id}`}>{field.label}</label>
                      <output class="tool-field-value" data-output-for={field.id} for={`tool-field-${field.id}`}>
                        {field.prefix}
                        {field.value}
                        {field.suffix ? ` ${field.suffix}` : ''}
                        {(field.id === 'finish' ||
                          field.id === 'intensity' ||
                          field.id === 'storage' ||
                          field.id === 'complexity') &&
                          ` · ${finishLabels[field.value] ?? ''}`}
                      </output>
                    </div>
                    <input
                      type="range"
                      id={`tool-field-${field.id}`}
                      name={field.id}
                      data-field-id={field.id}
                      min={field.min}
                      max={field.max}
                      step={field.step}
                      value={field.value}
                      data-default-value={field.value}
                      data-prefix={field.prefix ?? ''}
                      data-suffix={field.suffix ?? ''}
                      data-banded={
                        field.id === 'finish' ||
                        field.id === 'intensity' ||
                        field.id === 'storage' ||
                        field.id === 'complexity'
                          ? 'true'
                          : 'false'
                      }
                    />
                    <div class="tool-field-scale" aria-hidden="true">
                      <span>
                        {field.prefix}
                        {field.min}
                        {field.suffix ? ` ${field.suffix}` : ''}
                      </span>
                      <span>
                        {field.prefix}
                        {field.max}
                        {field.suffix ? ` ${field.suffix}` : ''}
                      </span>
                    </div>
                  </div>
                ))}
              </div>
              <div class="tool-result" id="tool-result" aria-live="polite">
                <p class="tool-result-label">Indicative estimate</p>
                <p class="tool-result-value" id="tool-result-value"> - </p>
                <p class="tool-result-note" id="tool-result-note"></p>
              </div>
            </div>
          )
        }

        {
          calc.type === 'layout-picker' && (
            <div class="tool-calc-body">
              <div class="tool-options" role="listbox" aria-label="Kitchen layout options">
                {calc.options.map((option, index) => (
                  <button
                    type="button"
                    class:list={['tool-option', { 'is-selected': index === 0 }]}
                    role="option"
                    aria-selected={index === 0 ? 'true' : 'false'}
                    data-option-id={option.id}
                    data-recommendation={option.description}
                  >
                    <span class="tool-option-label">{option.label}</span>
                    <span class="tool-option-desc">{option.description}</span>
                  </button>
                ))}
              </div>
              <div class="tool-result" id="tool-result" aria-live="polite">
                <p class="tool-result-label">Recommendation</p>
                <p class="tool-result-value tool-result-value--text" id="tool-result-value">
                  {calc.options[0]?.description}
                </p>
                <p class="tool-result-note">
                  Share this preference in your consultation - we will confirm clearances on a site
                  measure.
                </p>
              </div>
            </div>
          )
        }

        {
          calc.type === 'countdown' && (
            <div class="tool-calc-body tool-calc-body--countdown">
              <div class="tool-field tool-field--date">
                <label for="tool-countdown-date">Target opening date</label>
                <input type="date" id="tool-countdown-date" name="openingDate" />
              </div>
              <div class="tool-result" id="tool-result" aria-live="polite">
                <p class="tool-result-label">Days remaining</p>
                <p class="tool-result-value" id="tool-result-value"> - </p>
                <p class="tool-result-note" id="tool-result-note">
                  Use the buffer to freeze drawings, confirm materials, and schedule installation.
                </p>
              </div>
            </div>
          )
        }

      </div>
    </div>
  </section>

  <section class="tool-insights" aria-labelledby="tool-insights-title">
    <div class="container">
      <div class="tool-section-head">
        <p class="section-label fade-up">Understand your result</p>
        <h2 class="tool-section-title fade-up" id="tool-insights-title">{experience.resultTitle}</h2>
        <p class="tool-section-lead fade-up">{experience.resultLead}</p>
      </div>
      <div class="tool-insight-grid">
        {experience.insightCards.map((card, index) => (
          <article class="tool-insight-card fade-up">
            <span>{String(index + 1).padStart(2, '0')}</span>
            <h3>{card.title}</h3>
            <p>{card.description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="tool-guidance-section" aria-labelledby="tool-guidance-title">
    <div class="container">
      <aside class="tool-guidance fade-up">
        <p class="section-label">Planning check</p>
        <h2 id="tool-guidance-title">{experience.guidanceTitle}</h2>
        <ul class="feature-list">
          {experience.guidance.map((item) => <li>{item}</li>)}
        </ul>
      </aside>
    </div>
  </section>

  <section class="tool-resources" aria-labelledby="tool-resources-title">
    <div class="container">
      <div class="tool-section-head tool-resources-head">
        <p class="section-label fade-up">Continue planning</p>
        <div class="tool-resources-title-row">
          <h2 class="tool-section-title fade-up" id="tool-resources-title">From rough result to a measured plan</h2>
          <a href="/tools" class="tool-all-badge">All tools</a>
        </div>
      </div>
      <div class="tool-resource-grid">
        <a class="tool-resource-card fade-up" href={experience.service.href}>
          <div class="tool-resource-copy">
            <span class="tool-resource-icon"><MenuIcon name="buildings" /></span>
            <div class="tool-resource-text">
              <span>Relevant service</span>
              <strong>{experience.service.label}</strong>
              <em>See layouts, finishes, process, and FAQs</em>
            </div>
          </div>
        </a>
        <a class="tool-resource-card fade-up" href={experience.guide.href}>
          <div class="tool-resource-copy">
            <span class="tool-resource-icon"><MenuIcon name="books" /></span>
            <div class="tool-resource-text">
              <span>Planning guide</span>
              <strong>{experience.guide.label}</strong>
              <em>Read the decisions behind the estimate</em>
            </div>
          </div>
        </a>
        <a class="tool-resource-card fade-up" href={companionTool.href}>
          <div class="tool-resource-copy">
            <span class="tool-resource-icon"><MenuIcon name="compass-tool" /></span>
            <div class="tool-resource-text">
              <span>Next tool</span>
              <strong>{companionTool.label}</strong>
              <em>Check the next part of your project</em>
            </div>
          </div>
        </a>
      </div>
    </div>
  </section>

  <script src="/js/tools.js" defer></script>
</BaseLayout>
