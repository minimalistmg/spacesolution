---
import type { ImageMetadata } from 'astro';
import ResponsiveImage from './ResponsiveImage.astro';
import '../styles/pastel-story-cards.css';

export interface PastelStoryCard {
  title: string;
  description: string;
  href: string;
  image: ImageMetadata;
  /** Soft pastel tone key */
  tone?: 'blue' | 'peach' | 'yellow' | 'sage' | 'sand' | 'mist';
}

interface Props {
  heading?: string;
  cards: PastelStoryCard[];
}

const { heading, cards } = Astro.props;
const tones: NonNullable<PastelStoryCard['tone']>[] = [
  'blue',
  'peach',
  'yellow',
  'sage',
  'sand',
  'mist',
];
---

<section class="pastel-story">
  <div class="container">
    {heading && <h2 class="pastel-story-heading fade-up">{heading}</h2>}
    <div class="pastel-story-grid">
      {
        cards.map((card, index) => (
          <a
            href={card.href}
            class:list={['pastel-story-card', 'fade-up', `pastel-story-card--${card.tone ?? tones[index % tones.length]}`]}
          >
            <div class="pastel-story-media">
              <ResponsiveImage src={card.image} alt={card.title} preset="grid" />
            </div>
            <div class="pastel-story-body">
              <h3 class="pastel-story-title">{card.title}</h3>
              <p class="pastel-story-desc">{card.description}</p>
              <span class="pastel-story-btn" aria-hidden="true">
                <svg viewBox="0 0 16 16" focusable="false">
                  <path d="M3 8 H13"></path>
                  <path d="M9 4 L13 8 L9 12"></path>
                </svg>
              </span>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</section>
