---
export type BrandIconName = 'meet' | 'zoom' | 'teams';

interface Props {
  name: BrandIconName;
  class?: string;
}

const { name, class: className } = Astro.props;
---

{
  name === 'meet' && (
    <svg
      class:list={['brand-icon', 'brand-icon-meet', className]}
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
      aria-hidden="true"
    >
      <path
        fill="#00832D"
        d="M6.75 5.25A2.25 2.25 0 0 0 4.5 7.5v9a2.25 2.25 0 0 0 2.25 2.25H12V5.25H6.75z"
      />
      <path
        fill="#0066DA"
        d="M12 5.25v13.5h5.25A2.25 2.25 0 0 0 19.5 16.5v-9a2.25 2.25 0 0 0-2.25-2.25H12z"
      />
      <path
        fill="#EA4335"
        d="M19.5 7.95 22.35 6.3a.9.9 0 0 1 1.4.75v9.9a.9.9 0 0 1-1.4.75L19.5 16.05V7.95z"
      />
      <path fill="#2684FC" d="M12 9.75h3v4.5h-3v-4.5z" />
      <path fill="#00AC47" d="M7.5 9.75h3v4.5h-3v-4.5z" />
    </svg>
  )
}

{
  name === 'zoom' && (
    <svg
      class:list={['brand-icon', 'brand-icon-zoom', className]}
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
      aria-hidden="true"
    >
      <path
        fill="#2D8CFF"
        d="M13.5 6.5h6.75A1.25 1.25 0 0 1 21.5 7.75v8.5a1.25 1.25 0 0 1-1.25 1.25H13.5l-3.2 2.56a.75.75 0 0 1-1.3-.56v-2h-1A1.25 1.25 0 0 1 6.75 16.5v-9A1.25 1.25 0 0 1 8 6.25h1V4.69a.75.75 0 0 1 1.3-.56l3.2 2.37z"
      />
      <path
        fill="#fff"
        d="M9.25 8.25h7.5a.75.75 0 0 1 .75.75v6a.75.75 0 0 1-.75.75h-7.5a.75.75 0 0 1-.75-.75V9a.75.75 0 0 1 .75-.75z"
      />
    </svg>
  )
}

{
  name === 'teams' && (
    <svg
      class:list={['brand-icon', 'brand-icon-teams', className]}
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
      aria-hidden="true"
    >
      <path fill="#5059C9" d="M18.5 8.25a2.25 2.25 0 1 1-4.5 0 2.25 2.25 0 0 1 4.5 0z" />
      <path fill="#7B83EB" d="M20.75 10.5v6.75A1.5 1.5 0 0 1 19.25 18.75H12v-8.25h8.75z" />
      <path fill="#5059C9" d="M12 10.5V18.75H4.5A1.5 1.5 0 0 1 3 17.25v-6A1.5 1.5 0 0 1 4.5 9.75H12z" />
      <circle cx="8.25" cy="6" r="2.25" fill="#7B83EB" />
      <path fill="#fff" d="M7.125 12.375h2.25v1.125H7.125v-1.125zm0 2.25h2.25v1.125H7.125v-1.125z" />
      <path fill="#fff" opacity="0.9" d="M15.75 13.125h2.25v1.125h-2.25v-1.125zm0 2.25h2.25v1.125h-2.25v-1.125z" />
    </svg>
  )
}
