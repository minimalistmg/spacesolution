---
interface Props {
  formId: string;
  compact?: boolean;
}

const { formId, compact = false } = Astro.props;
---

<div class:list={['h3d-fields', { 'h3d-fields--compact': compact }]}>
  <div class="floating-contact-form-group">
    <label for={`${formId}-name`}>Your Name</label>
    <input id={`${formId}-name`} type="text" name="name" placeholder="Your name" autocomplete="name" />
  </div>

  <div class="floating-contact-form-group">
    <label for={`${formId}-phone`}>Phone Number</label>
    <input
      id={`${formId}-phone`}
      type="tel"
      name="phone"
      placeholder="98765 43210"
      autocomplete="tel"
      inputmode="numeric"
    />
  </div>

  <div class="floating-contact-form-group h3d-fields-message">
    <label for={`${formId}-message`}>Anything we should know?</label>
    <textarea
      id={`${formId}-message`}
      name="message"
      rows={compact ? 2 : 4}
      placeholder="Kitchen, two wardrobes, moving in December…"
    ></textarea>
    <p class="floating-contact-form-note">
      Floor plan, room sizes, or a budget range are enough to start. Photos on your phone are fine.
    </p>
  </div>

  <button type="submit" class="floating-contact-form-submit">Book free 3D consult</button>
  <p class="form-feedback" aria-live="polite"></p>
</div>
