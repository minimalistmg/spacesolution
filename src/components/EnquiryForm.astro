---
import ConnectInterestFields from './ConnectInterestFields.astro';
import { FORM_LABELS, FORM_LIMITS } from '../data/formFieldLabels';
import type { ConnectFormDefaults } from '../data/connectFormInterests';

interface Props {
  formId: string;
  dataSource: 'enquiry' | 'contact';
  defaults: ConnectFormDefaults;
  whatsappHref: string;
}

const { formId, dataSource, defaults, whatsappHref } = Astro.props;
---

<form
  id={formId}
  class="enquiry-form"
  data-source={dataSource}
  data-lead-connect="true"
  data-whatsapp={whatsappHref}
  data-default-category={defaults.category}
  data-default-sub={defaults.subServices.join(',')}
  novalidate
>
  <ConnectInterestFields formId={formId} defaults={defaults} />

  <div class="form-row">
    <div class="form-group">
      <label for={`${formId}-name`}>{FORM_LABELS.name}</label>
      <input
        id={`${formId}-name`}
        type="text"
        name="name"
        autocomplete="name"
        maxlength={FORM_LIMITS.nameMax}
        data-lead-field="name"
      />
    </div>
    <div class="form-group">
      <label for={`${formId}-mobile`}>{FORM_LABELS.mobile}</label>
      <input
        id={`${formId}-mobile`}
        type="tel"
        name="phone"
        autocomplete="tel"
        inputmode="numeric"
        maxlength={FORM_LIMITS.mobileLen}
        data-lead-field="mobile"
      />
    </div>
  </div>

  <div class="form-group">
    <label for={`${formId}-location`}>
      {FORM_LABELS.location} <span class="form-optional">{FORM_LABELS.optional}</span>
    </label>
    <input
      id={`${formId}-location`}
      type="text"
      name="location"
      autocomplete="address-level2"
      maxlength={FORM_LIMITS.locationMax}
      data-lead-field="location"
    />
  </div>

  <div class="form-group">
    <label for={`${formId}-message`}>
      {FORM_LABELS.message} <span class="form-optional">{FORM_LABELS.optional}</span>
    </label>
    <textarea
      id={`${formId}-message`}
      name="message"
      rows="3"
      maxlength={FORM_LIMITS.messageMax}
      data-lead-field="message"
    ></textarea>
  </div>

  <button type="submit" class="btn btn-gold-filled enquiry-form-submit">{FORM_LABELS.submit}</button>
  <p class="form-feedback" aria-live="polite"></p>
</form>
