---
import Icon from './Icon.astro';
import MenuIcon from './MenuIcon.astro';
import HeaderActions from './HeaderActions.astro';
import SegmentMegaMenu from './SegmentMegaMenu.astro';
import SiteLogo from './SiteLogo.astro';
import ConnectHubForm from './ConnectHubForm.astro';
import { isNavPanelActive, mainNavPanels } from '../data/mainNav';
import { isSegmentMegaMenuId, segmentMegaMenus } from '../data/segmentMegaMenus';
import { MEGA_MENU_HOVER_ARROW } from '../data/headerMenuIcons';
import { resolveConnectFormDefaults } from '../data/connectFormInterests';
import { SITE } from '../data/site';
import '../styles/header-contact-menu.css';

export type NavPage =
  | 'home-interiors'
  | 'commercial'
  | 'institutional'
  | 'hospitality'
  | 'studio'
  | 'portfolio'
  | 'library'
  | 'enquire'
  | 'services-residential'
  | 'services-commercial'
  | 'services-institutional'
  | 'services-hospitality'
  /** @deprecated use segment-specific keys above */
  | 'home'
  | 'services';

interface Props {
  activePage?: NavPage;
  scrolled?: boolean;
}

const { activePage = 'home', scrolled = false } = Astro.props;

const primaryPhone = SITE.phones[0];
const whatsappHref = `https://wa.me/${primaryPhone.replace('+', '')}`;

const resolvedActive = activePage === 'services' ? 'home-interiors' : activePage;
---

<header class:list={['site-header', { scrolled }]}>
  <div class="container header-inner">
    <SiteLogo class="logo" />

    <nav class="header-nav" aria-label="Main navigation">
      <ul class="main-nav">
        {
          mainNavPanels.map((panel) => (
            <li
              class:list={['has-mega-menu', { active: isNavPanelActive(panel.id, resolvedActive) }]}
              data-menu-panel={panel.id}
            >
              <a
                href={panel.hubHref}
            aria-haspopup="true"
            aria-expanded="false"
            aria-controls="global-nav-popover"
          >
                {panel.label}
          </a>
        </li>
          ))
        }
      </ul>

      <div id="global-nav-popover" class="global-nav-popover" aria-hidden="true">
        <div class="global-nav-popover-bridge" aria-hidden="true"></div>
        <div class="global-nav-popover-shell">
          <div class="global-nav-popover-surface">
            <div class="global-nav-popover-body">
            {
              mainNavPanels.map((panel) => (
                <div
                  class:list={[
                    'global-nav-panel',
                    { 'global-nav-panel--segment': isSegmentMegaMenuId(panel.id) },
                  ]}
                  data-menu-panel={panel.id}
                  data-panel-width={panel.width}
              role="region"
                  aria-label={panel.label}
                >
                  <a href={panel.featured.href} class="mega-menu-featured">
                    <span class="mega-menu-featured-icon">
                      <MenuIcon name={panel.featured.icon} />
                    </span>
                    <span class="mega-menu-featured-copy">
                      <span class="mega-menu-link-copy">
                        <strong class="mega-menu-link-label">{panel.featured.title}</strong>
                        <span class="mega-menu-link-arrow" aria-hidden="true">
                          <MenuIcon name={MEGA_MENU_HOVER_ARROW} />
                        </span>
                      </span>
                      <span>{panel.featured.description}</span>
                    </span>
                  </a>

                  {
                    isSegmentMegaMenuId(panel.id) ? (
                      <SegmentMegaMenu
                        menu={segmentMegaMenus[panel.id]}
                        toolsBand={panel.toolsBand}
                        footerBand={panel.footerBand}
                      />
                    ) : (
                      <>
                        <div class="mega-menu-home-body">
                          <div
                            class:list={[
                              'mega-menu-home-spotlight',
                              { 'mega-menu-home-spotlight--studio': panel.id === 'studio' },
                            ]}
                          >
                            {
                              panel.sections.map((section) => (
                                <div class="mega-menu-home-spotlight-col">
                                  <p class="mega-menu-section-heading">{section.heading}</p>
                                  <ul class="mega-menu-room-list">
                                    {
                                      section.items.map((item) => (
                                        <li>
                                          <a
                                            href={item.href}
                                            class="mega-menu-link mega-menu-room-list-link"
                                            data-open-modal={item.modal}
                                            target={item.target}
                                            rel={item.target === '_blank' ? 'noopener noreferrer' : undefined}
                                          >
                                            <span class="mega-menu-link-icon">
                                              <MenuIcon name={item.icon} />
                                            </span>
                                            <span class="mega-menu-link-copy">
                                              <span class="mega-menu-link-label">{item.label}</span>
                                              <span class="mega-menu-link-arrow" aria-hidden="true">
                                                <MenuIcon name={MEGA_MENU_HOVER_ARROW} />
                                              </span>
                                            </span>
                                          </a>
                                        </li>
                                      ))
                                    }
                                  </ul>
                                </div>
                              ))
                            }

                            {
                              (panel.toolsBand?.items.length || panel.footerBand?.items.length) && (
                                <div class="mega-menu-home-spotlight-col mega-menu-home-spotlight-col--guides">
                                  <div class="mega-menu-spotlight-block">
                                    {
                                      panel.toolsBand && panel.toolsBand.items.length > 0 && (
                                        <>
                                          <p class="mega-menu-section-heading">{panel.toolsBand.heading}</p>
                                          <ul class="mega-menu-tools-list">
                                            {
                                              panel.toolsBand.items.map((item) => (
                                                <li>
                                                  <a
                                                    href={item.href}
                                                    class="mega-menu-link"
                                                    data-open-modal={item.modal}
                                                    target={item.target}
                                                    rel={item.target === '_blank' ? 'noopener noreferrer' : undefined}
                                                  >
                                                    <span class="mega-menu-link-icon">
                                                      <MenuIcon name={item.icon} />
                                                    </span>
                                                    <span class="mega-menu-link-copy">
                                                      <span class="mega-menu-link-label">{item.label}</span>
                                                      <span class="mega-menu-link-arrow" aria-hidden="true">
                                                        <MenuIcon name={MEGA_MENU_HOVER_ARROW} />
                                                      </span>
                                                    </span>
                                                  </a>
                                                </li>
                                              ))
                                            }
                                          </ul>
                                        </>
                                      )
                                    }
                                    {
                                      panel.footerBand && panel.footerBand.items.length > 0 && (
                                        <>
                                          <p class="mega-menu-section-heading">{panel.footerBand.heading}</p>
                                          <ul class="mega-menu-guides-list">
                                            {
                                              panel.footerBand.items.map((item) => (
                                                <li>
                                                  <a
                                                    href={item.href}
                                                    class="mega-menu-link"
                                                    data-open-modal={item.modal}
                                                    target={item.target}
                                                    rel={item.target === '_blank' ? 'noopener noreferrer' : undefined}
                                                  >
                                                    <span class="mega-menu-link-icon">
                                                      <MenuIcon name={item.icon} />
                                                    </span>
                                                    <span class="mega-menu-link-copy">
                                                      <span class="mega-menu-link-label">{item.label}</span>
                                                      <span class="mega-menu-link-arrow" aria-hidden="true">
                                                        <MenuIcon name={MEGA_MENU_HOVER_ARROW} />
                                                      </span>
                                                    </span>
                                                  </a>
                                                </li>
                                              ))
                                            }
                                          </ul>
                                        </>
                                      )
                                    }
                                  </div>
                                </div>
                              )
                            }
                          </div>
                        </div>
                      </>
                    )
                  }
            </div>
              ))
            }
            <div
              class="global-nav-panel global-nav-panel--contact"
              data-menu-panel="contact"
              data-panel-width="710"
              role="region"
              aria-label="Contact"
            >
              <div class="hc-hub-body hc-hub-body--popover">
                <ConnectHubForm
                  formId="header-connect-form"
                  whatsappHref={whatsappHref}
                  telHref={`tel:${primaryPhone}`}
                  phoneDisplay={primaryPhone.replace(/^(\+91)(\d{5})(\d{5})$/, '$1 $2 $3')}
                  formDefaults={resolveConnectFormDefaults(
                    resolvedActive,
                    Astro.url.pathname,
                    Astro.url.searchParams.get('interest'),
                  )}
                />
              </div>
            </div>
          </div>
        </div>
        </div>
      </div>
    </nav>

    <div class="header-toolbar">
      <HeaderActions
        primaryPhone={primaryPhone}
        whatsappHref={whatsappHref}
        activePage={activePage}
      />

      <button
        class="menu-toggle menu-toggle-round"
        type="button"
        aria-label="Open menu"
        aria-expanded="false"
      >
        <span class="menu-toggle-fab-state menu-toggle-fab-state--open" aria-hidden="true">
          <Icon name="bars" />
        </span>
        <span class="menu-toggle-fab-state menu-toggle-fab-state--close" aria-hidden="true">
          <Icon name="times" />
        </span>
      </button>
    </div>
  </div>
</header>

<button
  class="menu-toggle menu-toggle-fab"
  type="button"
  aria-label="Open menu"
  aria-expanded="false"
>
  <span class="menu-toggle-fab-state menu-toggle-fab-state--open" aria-hidden="true">
    <Icon name="bars" />
  </span>
  <span class="menu-toggle-fab-state menu-toggle-fab-state--close" aria-hidden="true">
    <Icon name="times" />
  </span>
</button>
