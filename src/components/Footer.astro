---
import Icon from './Icon.astro';
import SiteLogo from './SiteLogo.astro';
import FooterLetsTalk from './FooterLetsTalk.astro';
import { SITE } from '../data/site';
---

<div class="footer-reveal">
  <div class="footer-reveal-panel">
    <FooterLetsTalk />

    <footer class="site-footer">
      <div class="footer-shell">
        <div class="footer-promises">
          <article class="footer-promise">
            <Icon name="compass" class="footer-promise-icon" />
            <h3>Discovery</h3>
            <p>
              We start with how you live and work — site context, brief, and priorities — so the plan fits Mysuru
              homes and commercial spaces from day one.
            </p>
          </article>
          <article class="footer-promise">
            <Icon name="pencil-ruler" class="footer-promise-icon" />
            <h3>Design</h3>
            <p>
              Layouts, materials, and detailing are resolved in-house before production, so finishes stay consistent
              from drawings through fabrication.
            </p>
          </article>
          <article class="footer-promise">
            <Icon name="key" class="footer-promise-icon" />
            <h3>Handover</h3>
            <p>
              Installation and snagging are handled by our team through final handover — one accountable path from
              design to a finished interior.
            </p>
          </article>
        </div>

        <div class="footer-main">
          <div class="footer-nav">
            <div class="footer-col footer-col-social">
              <SiteLogo class="footer-logo" />
              <h4>Social Media</h4>
              <div class="footer-social-icons">
                <a href={SITE.social.facebook} target="_blank" rel="noopener noreferrer" aria-label="Facebook">
                  <Icon name="facebook" />
                </a>
                <a href={SITE.social.instagram} target="_blank" rel="noopener noreferrer" aria-label="Instagram">
                  <Icon name="instagram" />
                </a>
                <a href={SITE.social.linkedin} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
                  <Icon name="linkedin" />
                </a>
                <a href={SITE.social.youtube} target="_blank" rel="noopener noreferrer" aria-label="YouTube">
                  <Icon name="youtube" />
                </a>
              </div>
            </div>
            <div class="footer-col">
              <h4>Services</h4>
              <ul class="footer-links">
                <li><a href="/residential-interiors">Residential Interiors</a></li>
                <li><a href="/commercial-interiors">Commercial</a></li>
                <li><a href="/institutional-interiors">Institutional</a></li>
                <li><a href="/turnkey-fitout">Turnkey Fitout</a></li>
              </ul>
            </div>
            <div class="footer-col">
              <h4>The Company</h4>
              <ul class="footer-links">
                <li><a href="/about">About</a></li>
                <li><a href="/portfolio">Projects</a></li>
                <li><a href="/contact">Contact</a></li>
                <li><a href="/privacy-policy">Privacy Policy</a></li>
              </ul>
            </div>
          </div>

          <div class="footer-subscribe">
            <h4>Subscribe To Us!</h4>
            <p>Sign up for design updates and project stories from Space Solutions.</p>
            <form class="footer-subscribe-form" action="/contact" method="get">
              <label class="visually-hidden" for="footer-email">Your Email Address</label>
              <input
                id="footer-email"
                type="email"
                name="email"
                placeholder="Your Email Address"
                autocomplete="email"
                required
              />
              <button type="submit" aria-label="Subscribe">
                <Icon name="arrow-right" />
              </button>
            </form>
          </div>
        </div>

        <div class="footer-bottom">
          <p>&copy; {new Date().getFullYear()}, Space Solutions All rights reserved.</p>
        </div>
      </div>
    </footer>
  </div>
</div>
