---
import type { ImageMetadata } from 'astro';
import ResponsiveImage from './ResponsiveImage.astro';
import '../styles/inspire-bento.css';

interface Props {
  heroImage: ImageMetadata;
  ctaImage: ImageMetadata;
  heroHref?: string;
  ctaHref?: string;
}

const {
  heroImage,
  ctaImage,
  heroHref = '/portfolio',
  ctaHref = '/portfolio',
} = Astro.props;
---

<div class="inspire-bento fade-up">
  <a class="inspire-main" href={heroHref}>
    <div class="inspire-main-media">
      <ResponsiveImage
        src={heroImage}
        alt="Featured interior by Space Solutions"
        preset="content"
      />
    </div>

    {/* 3-step curtain: pill → Modern → Minimalist (matches concept) */}
    <div class="inspire-steps">
      <div class="inspire-step inspire-step--1">
        <span class="inspire-pill">Gorgeous Interior</span>
      </div>
      <div class="inspire-step inspire-step--2">
        <span class="inspire-step-word">Modern</span>
      </div>
      <div class="inspire-step inspire-step--3">
        <span class="inspire-step-word">Minimalist</span>
      </div>
    </div>
  </a>

  <div class="inspire-aside">
    <div class="inspire-aside-copy">
      <span class="inspire-pill">Aesthetic</span>
      <p class="inspire-aside-text">
        Aesthetic furniture where every piece tells a story of style
      </p>
      <h3 class="inspire-aside-title">
        Into a gallery<br />of elegance
      </h3>
    </div>

    <a class="inspire-cta" href={ctaHref} aria-label="View portfolio">
      <div class="inspire-cta-media">
        <ResponsiveImage
          src={ctaImage}
          alt="Browse Space Solutions portfolio"
          preset="grid"
        />
      </div>
      <div class="inspire-cta-overlay">
        <span class="inspire-pill inspire-pill--light">Best Furniture</span>
        <p>Indulge in the artistry<br />of everyday living</p>
      </div>
      <span class="inspire-cta-notch" aria-hidden="true"></span>
      <span class="inspire-cta-btn" aria-hidden="true">
        <svg viewBox="0 0 14 14" focusable="false">
          <path d="M3 11 L11 3"></path>
          <path d="M5.5 3 H11 V8.5"></path>
        </svg>
      </span>
    </a>
  </div>
</div>
