---
import Icon from './Icon.astro';
import EnquiryForm from './EnquiryForm.astro';
import type { ConnectFormDefaults } from '../data/connectFormInterests';

interface Props {
  defaults: ConnectFormDefaults;
  whatsappHref: string;
}

const { defaults, whatsappHref } = Astro.props;
---

<div
  class="modal-overlay"
  id="enquiry-modal"
  data-default-category={defaults.category}
  data-default-sub={defaults.subServices.join(',')}
>
  <div class="modal enquiry-modal">
    <div class="enquiry-modal-inner">
      <div class="enquiry-modal-head">
        <div class="enquiry-modal-head-copy">
          <h2>Enquiry Form</h2>
          <p class="enquiry-modal-desc">Share a few details and we will call you within one business day.</p>
        </div>
        <button class="modal-close" type="button" aria-label="Close"><Icon name="times" /></button>
      </div>
      <EnquiryForm
        formId="enquiry-form"
        dataSource="enquiry"
        defaults={defaults}
        whatsappHref={whatsappHref}
      />
    </div>
  </div>
</div>
