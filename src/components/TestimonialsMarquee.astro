---
import Icon from './Icon.astro';
import {
  GOOGLE_REVIEWS_HREF,
  MIN_TESTIMONIALS_FOR_MARQUEE,
  getTestimonials,
  getTestimonialsCopy,
  type Testimonial,
  type TestimonialCategory,
} from '../data/testimonials';
import '../styles/testimonials.css';

interface Props {
  category?: TestimonialCategory;
}

const { category } = Astro.props;
const items = getTestimonials(category);

function fillTrack(list: Testimonial[], min = 6): Testimonial[] {
  if (!list.length) return [];
  const filled = [...list];
  while (filled.length < min) filled.push(...list);
  return [...filled, ...filled];
}

const uniqueCount = items.length;
const showSection = uniqueCount >= MIN_TESTIMONIALS_FOR_MARQUEE;
const copy = getTestimonialsCopy(category);
const classicTrack = fillTrack(items);
const reverseTrack = fillTrack([...items].reverse());
const uniqueId = `testimonials-${category ?? 'home'}`;
---

{
  showSection && (
    <section class="testimonials" id="testimonials" aria-labelledby={uniqueId}>
      <div class="container testimonials-header">
        <p class="testimonials-badge">
          <span class="testimonials-badge-star">
            <Icon name="star" />
          </span>
          {copy.badge}
        </p>
        <h2 class="testimonials-heading" id={uniqueId}>
          {copy.headingBefore}
          <em>{copy.accent}</em>
          {copy.headingAfter}
        </h2>
      </div>

      <ul class="testimonials-sr">
        {items.map((item) => (
          <li>
            <blockquote>
              <p>{item.quote}</p>
              <footer>
                {item.name} - {item.project}, {item.locality}
              </footer>
            </blockquote>
          </li>
        ))}
      </ul>

      <div class="testimonials-marquee" aria-hidden="true">
        <div class="testimonials-fade testimonials-fade--left"></div>
        <div class="testimonials-fade testimonials-fade--right"></div>

        <div class="testimonials-row">
          <div class="testimonials-track">
            {classicTrack.map((item) => (
              <article class="testimonials-card">
                <span class="testimonials-quote-mark">“</span>
                <p class="testimonials-quote">{item.quote}</p>
                <div class="testimonials-author">
                  <span class="testimonials-avatar">{item.initials}</span>
                  <div class="testimonials-author-text">
                    <p class="testimonials-name-line">
                      <strong>{item.name}</strong>
                      <span class="testimonials-stars">
                        {Array.from({ length: item.rating }).map(() => (
                          <Icon name="star" />
                        ))}
                      </span>
                    </p>
                    <p class="testimonials-meta-line">
                      <span class="testimonials-project">{item.project}</span>
                      <span class="testimonials-sep" aria-hidden="true">
                        ·
                      </span>
                      <span class="testimonials-locality">{item.locality}</span>
                    </p>
                  </div>
                </div>
              </article>
            ))}
          </div>
        </div>

        <div class="testimonials-row">
          <div class="testimonials-track is-reverse">
            {reverseTrack.map((item) => (
              <article class="testimonials-card">
                <span class="testimonials-quote-mark">“</span>
                <p class="testimonials-quote">{item.quote}</p>
                <div class="testimonials-author">
                  <span class="testimonials-avatar">{item.initials}</span>
                  <div class="testimonials-author-text">
                    <p class="testimonials-name-line">
                      <strong>{item.name}</strong>
                      <span class="testimonials-stars">
                        {Array.from({ length: item.rating }).map(() => (
                          <Icon name="star" />
                        ))}
                      </span>
                    </p>
                    <p class="testimonials-meta-line">
                      <span class="testimonials-project">{item.project}</span>
                      <span class="testimonials-sep" aria-hidden="true">
                        ·
                      </span>
                      <span class="testimonials-locality">{item.locality}</span>
                    </p>
                  </div>
                </div>
              </article>
            ))}
          </div>
        </div>
      </div>

      <div class="container testimonials-actions">
        <a href="/stories" class="btn btn-gold-filled">
          <Icon name="book-open" />
          Read all client stories
        </a>
        <a
          class="btn btn-gold-outline"
          href={GOOGLE_REVIEWS_HREF}
          rel="noopener noreferrer"
          target="_blank"
        >
          <span class="testimonials-google-logo" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="18" height="18">
              <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 0 1-2.2 3.32v2.77h3.57c2.08-1.92 3.27-4.74 3.27-8.1Z" />
              <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84A10.97 10.97 0 0 0 12 23Z" />
              <path fill="#FBBC05" d="M5.84 14.09A6.59 6.59 0 0 1 5.5 12c0-.72.13-1.43.34-2.09V7.07H2.18A10.97 10.97 0 0 0 1 12c0 1.77.42 3.45 1.18 4.93l3.66-2.84Z" />
              <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1A10.97 10.97 0 0 0 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53Z" />
            </svg>
          </span>
          Read Google reviews
        </a>
      </div>
    </section>
  )
}
