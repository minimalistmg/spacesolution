---
import type { ImageMetadata } from 'astro';
import ResponsiveImage from './ResponsiveImage.astro';
import { pageHeroImage } from '../data/images';

interface HeroStat {
  value: string;
  label: string;
}

interface Props {
  breadcrumb: string;
  title: string;
  description?: string;
  image?: ImageMetadata;
  /** When set, hero photo extends behind this stats band (hospitality pattern). */
  stats?: HeroStat[];
}

const { breadcrumb, title, description, image = pageHeroImage, stats } = Astro.props;
const withStats = Boolean(stats?.length);
---

<section class:list={['page-hero', { 'page-hero--with-stats': withStats }]}>
  <div class="page-hero-bg" aria-hidden="true">
    <ResponsiveImage src={image} alt="" preset="hero" />
  </div>
  <div class="page-hero-overlay" aria-hidden="true"></div>

  <div class="container page-hero-content">
    <nav class="breadcrumb" aria-label="Breadcrumb" set:html={breadcrumb} />
    <h1 class="page-hero-title">{title}</h1>
    {description && <p class="page-hero-desc">{description}</p>}
  </div>

  {
    withStats && (
      <div class="page-hero-stats">
        <div class="page-hero-stats-tint" aria-hidden="true"></div>
        <div class="container page-hero-stats-grid">
          {stats!.map((stat) => (
            <div class="page-hero-stat fade-up">
              <span class="page-hero-stat-value">{stat.value}</span>
              <span class="page-hero-stat-label">{stat.label}</span>
            </div>
          ))}
        </div>
      </div>
    )
  }
</section>
