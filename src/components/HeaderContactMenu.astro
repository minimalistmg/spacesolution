---
import Icon from './Icon.astro';
import ConnectHubForm from './ConnectHubForm.astro';
import { resolveConnectFormDefaults } from '../data/connectFormInterests';
import type { NavPage } from './Header.astro';
import '../styles/header-contact-menu.css';

interface Props {
  primaryPhone: string;
  whatsappHref: string;
  activePage?: NavPage;
}

const { primaryPhone, whatsappHref, activePage = 'home' } = Astro.props;

const telHref = `tel:${primaryPhone}`;
const phoneDisplay = primaryPhone.replace(/^(\+91)(\d{5})(\d{5})$/, '$1 $2 $3');
const formDefaults = resolveConnectFormDefaults(
  activePage,
  Astro.url.pathname,
  Astro.url.searchParams.get('interest'),
);
---

<div class="header-actions" id="header-contact-actions">
  <div class="hc-smart hc-hub" data-contact-smart>
    <button
      type="button"
      class="hc-hub-pill-btn hc-hub-trigger"
      data-contact-trigger="hub"
      aria-expanded="false"
      aria-controls="global-nav-popover"
      aria-label="Contact - open contact options"
    >
      <span class="hc-glass-filter" aria-hidden="true"></span>
      <span class="hc-glass-overlay" aria-hidden="true"></span>
      <span class="hc-glass-specular" aria-hidden="true"></span>
      <span class="hc-glass-content">
        <span class="hc-hub-pill-btn-icon hc-cta-icons" aria-hidden="true">
          <span class="hc-cta-icon">
            <Icon name="envelope" />
          </span>
          <span class="hc-cta-icon hc-cta-icon--phone">
            <Icon name="phone" />
          </span>
          <span class="hc-cta-icon">
            <Icon name="whatsapp" />
          </span>
        </span>
        <span class="hc-hub-pill-btn-label">Contact</span>
      </span>
    </button>

    <svg class="hc-glass-svg" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
      <filter
        id="hc-lens-filter"
        x="0%"
        y="0%"
        width="100%"
        height="100%"
        filterUnits="objectBoundingBox"
      >
        <feComponentTransfer in="SourceAlpha" result="alpha">
          <feFuncA type="identity"></feFuncA>
        </feComponentTransfer>
        <feGaussianBlur in="alpha" stdDeviation="50" result="blur"></feGaussianBlur>
        <feDisplacementMap
          in="SourceGraphic"
          in2="blur"
          scale="50"
          xChannelSelector="A"
          yChannelSelector="A"
        ></feDisplacementMap>
      </filter>
    </svg>

    <div class="hc-hub-mobile-backdrop" data-contact-backdrop hidden aria-hidden="true"></div>

    <div class="hc-hub-panel hc-hub-panel--mobile-only" data-contact-panel="hub" hidden>
      <div class="hc-hub-panel-surface">
        <div class="hc-hub-sheet-handle-wrap" aria-hidden="true">
          <span class="hc-hub-sheet-handle"></span>
        </div>
        <div class="hc-hub-body">
          <ConnectHubForm
            formId="header-connect-form-mobile"
            idPrefix="mobile-"
            whatsappHref={whatsappHref}
            telHref={telHref}
            phoneDisplay={phoneDisplay}
            formDefaults={formDefaults}
          />
        </div>
      </div>
    </div>
  </div>
</div>
