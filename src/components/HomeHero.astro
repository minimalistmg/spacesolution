---
/**
 * Home hero - light editorial split.
 * Copy left, framed media right with showreel thumbnail and Since 2011 badge.
 */
import ResponsiveImage from './ResponsiveImage.astro';
import { heroImages } from '../data/images';
import '../styles/home-hero.css';

const stats = [
  { value: '15+', label: 'Years of Expertise' },
  { value: '800+', label: 'Projects Delivered' },
  { value: 'In-House', label: 'Manufacturing' },
  { value: 'Mysuru', label: 'Karnataka' },
] as const;

const slides = [
  {
    src: heroImages.residential,
    label: 'Home',
    alt: 'Residential living room with oak slatted wall and linen seating',
  },
  {
    src: heroImages.commercial,
    label: 'Commercial',
    alt: 'Commercial interior workspace designed and finished by Space Solution',
  },
  {
    src: heroImages.institutional,
    label: 'Institutional',
    alt: 'Institutional interior with custom joinery and planned circulation',
  },
  {
    src: heroImages.hospitality,
    label: 'Hospitality',
    alt: 'Hospitality interior with warm lighting and custom furniture',
  },
] as const;

const curtainStrips = [0, 1, 2, 3, 4, 5, 6, 7] as const;
---

<section class="home-hero" aria-label="Introduction">
  <div class="home-hero-wash" aria-hidden="true"></div>

  <div class="container home-hero-inner">
    <div class="home-hero-copy">
      <h1 class="home-hero-title" data-hero-reveal>
        Interiors,<br />
        <span class="home-hero-title-accent">end to end.</span>
      </h1>
      <p class="home-hero-lead" data-hero-reveal>
        Design, manufacturing and installation - delivered by one team in Mysuru.
        Fifteen years of turnkey interiors, finished to the drawing.
      </p>
      <div class="home-hero-actions" data-hero-reveal>
        <a href="#" class="btn btn-gold-filled" data-open-modal="enquiry">Get Consultation</a>
        <a href="/portfolio" class="btn btn-outline-dark">View Portfolio</a>
      </div>
    </div>

    <div class="home-hero-media">
      <figure
        class="home-hero-still"
        data-hero-slideshow
        aria-label="Interiors across home, commercial, institutional, and hospitality"
      >
        {
          slides.map((slide, index) => (
            <div
              class:list={['home-hero-slide', { 'is-current': index === 0 }]}
              data-hero-slide
              data-label={slide.label}
              aria-hidden={index === 0 ? 'false' : 'true'}
            >
              <ResponsiveImage
                src={slide.src}
                alt={slide.alt}
                preset="hero"
                sizes="(max-width: 980px) 92vw, 46vw"
                loading={index === 0 ? 'eager' : 'lazy'}
                fetchpriority={index === 0 ? 'high' : 'low'}
              />
            </div>
          ))
        }
        <div class="home-hero-curtain" data-hero-curtain aria-hidden="true">
          {curtainStrips.map((index) => <span style={`--i: ${index}`} />)}
        </div>
        <figcaption class="home-hero-slide-label" data-hero-slide-label>
          {slides[0].label}
        </figcaption>
      </figure>

      <div class="home-hero-reel">
        <video
          class="home-hero-video"
          autoplay
          muted
          loop
          playsinline
          disablepictureinpicture
          disableremoteplayback
          controlslist="nodownload noplaybackrate noremoteplayback"
          preload="metadata"
          aria-label="Space Solution studio tour"
        >
          <source src="/videos/home-hero.mp4" type="video/mp4" />
        </video>
        <p class="home-hero-reel-label">Studio tour</p>
      </div>

      <span class="home-hero-badge" aria-hidden="true">
        <span class="home-hero-badge-value">2011</span>
        <span class="home-hero-badge-label">Since</span>
      </span>
    </div>
  </div>

  <div class="home-hero-stats" aria-label="Company highlights">
    <div class="container home-hero-stats-grid">
      {
        stats.map((stat) => (
          <div class="home-hero-stat" data-hero-reveal>
            <span class="home-hero-stat-value">{stat.value}</span>
            <span class="home-hero-stat-label">{stat.label}</span>
          </div>
        ))
      }
    </div>
  </div>
</section>

<script is:inline>
  (function () {
    var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var video = document.querySelector('.home-hero-video');

    if (video) {
      if (reduce) {
        video.removeAttribute('autoplay');
        video.pause();
      } else {
        var play = video.play();
        if (play && typeof play.catch === 'function') {
          play.catch(function () {
            /* autoplay may be blocked; the first frame still shows */
          });
        }
      }
    }

    var still = document.querySelector('[data-hero-slideshow]');
    if (!still || reduce) return;

    var slides = still.querySelectorAll('[data-hero-slide]');
    var curtain = still.querySelector('[data-hero-curtain]');
    var label = still.querySelector('[data-hero-slide-label]');
    if (slides.length < 2 || !curtain) return;

    var index = 0;
    var busy = false;
    var kenMs = 7000;
    var introMs = 1200;
    var curtainMs = 1350;
    var fadeMs = 200;
    var timer;

    function preload(slide) {
      var img = slide.querySelector('img');
      if (img && typeof img.decode === 'function') {
        img.decode().catch(function () {});
      }
    }

    function setLabel(slide) {
      if (!label) return;
      label.textContent = slide.getAttribute('data-label') || '';
    }

    function freezeSlide(slide) {
      var img = slide.querySelector('img');
      if (!img) return;
      img.style.transform = window.getComputedStyle(img).transform;
      img.style.animation = 'none';
      slide.classList.remove('is-ken');
    }

    function clearFreeze(slide) {
      var img = slide.querySelector('img');
      if (!img) return;
      img.style.transform = '';
      img.style.animation = '';
    }

    function scheduleNext() {
      stop();
      if (document.hidden) return;
      timer = window.setTimeout(goNext, kenMs);
    }

    function startKen(slide) {
      slide.classList.remove('is-ken');
      void slide.offsetWidth;
      slide.classList.add('is-ken');
      scheduleNext();
    }

    function hideSlide(slide) {
      slide.classList.remove('is-current', 'is-incoming', 'is-ken');
      slide.setAttribute('aria-hidden', 'true');
      clearFreeze(slide);
    }

    function goNext() {
      if (busy || document.hidden) return;
      busy = true;

      var outgoing = slides[index];
      index = (index + 1) % slides.length;
      var incoming = slides[index];
      var img = incoming.querySelector('img');
      var handedOff = false;

      freezeSlide(outgoing);
      preload(incoming);
      setLabel(incoming);

      function playCurtain() {
        var src = img ? img.currentSrc || img.src : '';
        if (src) {
          curtain.style.setProperty('--hero-curtain-src', 'url("' + src + '")');
        }

        curtain.classList.remove('is-on', 'is-exit');
        void curtain.offsetWidth;
        curtain.classList.add('is-on');

        window.setTimeout(function () {
          if (handedOff) return;
          handedOff = true;

          incoming.classList.add('is-current', 'is-incoming');
          incoming.setAttribute('aria-hidden', 'false');

          window.requestAnimationFrame(function () {
            hideSlide(outgoing);
            window.requestAnimationFrame(function () {
              curtain.classList.add('is-exit');
              window.setTimeout(function () {
                incoming.classList.remove('is-incoming');
                curtain.classList.remove('is-on', 'is-exit');
                busy = false;
                preload(slides[(index + 1) % slides.length]);
                startKen(incoming);
              }, fadeMs);
            });
          });
        }, curtainMs);
      }

      if (img && typeof img.decode === 'function') {
        img.decode().then(playCurtain, playCurtain);
      } else {
        playCurtain();
      }
    }

    function stop() {
      if (timer) window.clearTimeout(timer);
      timer = 0;
    }

    preload(slides[1]);
    window.setTimeout(function () {
      startKen(slides[0]);
    }, introMs);

    document.addEventListener('visibilitychange', function () {
      if (document.hidden) stop();
      else if (!busy) scheduleNext();
    });
  })();
</script>
