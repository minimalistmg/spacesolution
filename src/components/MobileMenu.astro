---
import Icon from './Icon.astro';
import MenuIcon from './MenuIcon.astro';
import type { NavPage } from './Header.astro';
import { isNavPanelActive, mainNavPanels } from '../data/mainNav';
import type { MainNavFooterBand, MainNavPanel, MainNavSection } from '../data/mainNav';
import '../styles/mobile-menu-master-detail.css';

interface Props {
  activePage?: NavPage;
}

const { activePage = 'home' } = Astro.props;

const resolvedActive = activePage === 'services' ? 'home-interiors' : activePage;

const defaultPanelId =
  mainNavPanels.find((panel) => isNavPanelActive(panel.id, resolvedActive))?.id ?? 'home';

const segmentAccents: Record<string, string> = {
  home: '#e67e22',
  commercial: '#4682b4',
  institutional: '#2e8b57',
  hospitality: '#c05840',
  studio: '#7e22ce',
};

function detailGroups(panel: MainNavPanel): { heading: string; items: MainNavSection['items'] }[] {
  const groups: { heading: string; items: MainNavSection['items'] }[] = panel.sections.map((section) => ({
    heading: section.heading,
    items: section.items,
  }));

  const appendBand = (band: MainNavFooterBand | undefined) => {
    if (!band || band.items.length === 0) return;
    groups.push({ heading: band.heading, items: band.items });
  };

  appendBand(panel.toolsBand);
  appendBand(panel.footerBand);
  return groups;
}
---

<div class="mobile-menu-backdrop mobile-menu-overlay" aria-hidden="true"></div>

<div class="mobile-menu mobile-menu--master-detail">
  <div class="mobile-menu-master-detail">
    <nav class="mobile-menu-rail" aria-label="Site sections">
      {
        mainNavPanels.map((panel) => (
          <button
            type="button"
            class:list={['mobile-menu-rail-item', { 'is-active': panel.id === defaultPanelId }]}
            data-panel={panel.id}
            style={`--segment-accent: ${segmentAccents[panel.id] ?? '#d4a017'}`}
            aria-selected={panel.id === defaultPanelId ? 'true' : 'false'}
          >
            <span class="mobile-menu-rail-icon" aria-hidden="true">
              <MenuIcon name={panel.featured.icon} />
            </span>
            <span class="mobile-menu-rail-label">{panel.label}</span>
          </button>
        ))
      }
    </nav>

    <div class="mobile-menu-detail">
      {
        mainNavPanels.map((panel) => (
          <div
            class:list={['mobile-menu-detail-pane', { 'is-active': panel.id === defaultPanelId }]}
            data-panel={panel.id}
            hidden={panel.id !== defaultPanelId ? true : undefined}
          >
            <a
              href={panel.featured.href}
              class="mobile-menu-detail-featured"
              style={`--segment-accent: ${segmentAccents[panel.id] ?? '#d4a017'}`}
            >
              <span class="mobile-menu-detail-featured-icon" aria-hidden="true">
                <MenuIcon name={panel.featured.icon} />
              </span>
              <span class="mobile-menu-detail-featured-copy">
                <strong class="mobile-menu-detail-featured-title">{panel.featured.title}</strong>
                <span class="mobile-menu-detail-featured-desc">{panel.featured.description}</span>
              </span>
              <span class="mobile-menu-detail-featured-chevron" aria-hidden="true">
                <MenuIcon name="caret-right" />
              </span>
            </a>

            {
              detailGroups(panel).map((group) => (
                <section class="mobile-menu-detail-group">
                  <h3 class="mobile-menu-detail-heading">{group.heading}</h3>
                  <ul class="mobile-menu-detail-list">
                    {
                      group.items.map((item) => (
                        <li>
                          <a
                            href={item.href}
                            class="mobile-menu-detail-link"
                            data-open-modal={item.modal}
                            target={item.target}
                            rel={item.target === '_blank' ? 'noopener noreferrer' : undefined}
                            data-contact-action={
                              item.href.startsWith('tel:')
                                ? 'call'
                                : item.href.includes('wa.me')
                                  ? 'whatsapp'
                                  : undefined
                            }
                          >
                            <span class="mobile-menu-detail-link-icon" aria-hidden="true">
                              <MenuIcon name={item.icon} />
                            </span>
                            <span class="mobile-menu-detail-link-label">{item.label}</span>
                            <span class="mobile-menu-detail-link-chevron" aria-hidden="true">
                              <MenuIcon name="caret-right" />
                            </span>
                          </a>
                        </li>
                      ))
                    }
                  </ul>
                </section>
              ))
            }
          </div>
        ))
      }
    </div>
  </div>

  <div class="mobile-menu-footer">
    <button type="button" class="mobile-menu-connect-btn hc-hub-pill-btn" data-mobile-menu-connect>
      <span class="hc-hub-pill-btn-icon" aria-hidden="true">
        <Icon name="comment-dots" />
      </span>
      <span class="hc-hub-pill-btn-label">Connect</span>
    </button>
  </div>
</div>
