---
import Icon from './Icon.astro';
import type { NavPage } from './Header.astro';
import SiteLogo from './SiteLogo.astro';
import { isNavPanelActive, mainNavPanels } from '../data/mainNav';
import { SITE } from '../data/site';

interface Props {
  activePage?: NavPage;
}

const { activePage = 'home' } = Astro.props;

const primaryPhone = SITE.phones[0];
const phoneDisplay = '+91 63645 64563';

const resolvedActive = activePage === 'services' ? 'home-interiors' : activePage;
---

<div class="mobile-menu">
  <div class="mobile-menu-header">
    <SiteLogo />
    <button class="mobile-close" type="button" aria-label="Close menu"><Icon name="times" /></button>
  </div>

  <div class="mobile-menu-actions">
    <a href={`tel:${primaryPhone}`} class="mobile-menu-phone" data-contact-action="call">
      <Icon name="phone" />
      <span>{phoneDisplay}</span>
    </a>
    <div class="mobile-menu-cta-row">
      <a
        href={`https://wa.me/${primaryPhone.replace('+', '')}`}
        class="mobile-menu-whatsapp"
        target="_blank"
        rel="noopener"
        aria-label="WhatsApp us"
        data-contact-action="whatsapp"
      >
        <Icon name="whatsapp" />
      </a>
      <a href="#" class="btn header-btn header-btn-quote" data-open-modal="enquiry">Get Quote</a>
    </div>
  </div>

  <nav class="mobile-nav" aria-label="Mobile navigation">
    {
      mainNavPanels.map((panel) => (
        <div class="has-submenu">
          <a
            href={panel.hubHref}
            class:list={[{ active: isNavPanelActive(panel.id, resolvedActive) }]}
          >
            {panel.label}
          </a>
          <div class="submenu-mobile" style="display:none">
            <a href={panel.featured.href} class="mobile-nav-featured">
              {panel.featured.title}
            </a>
            {panel.sections.map((section) => (
              <>
                <span class="mobile-nav-group">{section.heading}</span>
                {section.items.map((item) => (
                  <a href={item.href} data-open-modal={item.modal}>
                    {item.label}
                  </a>
                ))}
              </>
            ))}
            {
              panel.toolsBand && panel.toolsBand.items.length > 0 && (
                <>
                  <span class="mobile-nav-group">{panel.toolsBand.heading}</span>
                  {panel.toolsBand.items.map((item) => (
                    <a href={item.href} class="mobile-nav-turnkey">
                      {item.label}
                    </a>
                  ))}
                </>
              )
            }
            {
              panel.footerBand && panel.footerBand.items.length > 0 && (
                <>
                  <span class="mobile-nav-group">{panel.footerBand.heading}</span>
                  {panel.footerBand.items.map((item) => (
                    <a href={item.href} class="mobile-nav-turnkey">
                      {item.label}
                    </a>
                  ))}
                </>
              )
            }
          </div>
        </div>
      ))
    }
  </nav>
</div>
