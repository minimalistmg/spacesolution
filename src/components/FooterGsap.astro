---
import Icon from './Icon.astro';
import LogoMark from './LogoMark.astro';
import { SITE } from '../data/site';
import { FOOTER_BLUEPRINT_COLUMNS } from '../data/footerBlueprintLinks';
import { FOOTER_LOOP_OBJECTS } from '../data/footerGsapLayouts';
import { altFromPublicImage } from '../lib/publicImage';
import '../styles/footer-gsap.css';

/* Duplicate track for seamless infinite loop */
const trackObjects = [...FOOTER_LOOP_OBJECTS, ...FOOTER_LOOP_OBJECTS];
---

<footer
  class="fgsap-footer"
  data-fgsap-variant="v1"
  aria-label="Space Solution footer — unified object loop"
>
  <div class="fgsap-inner">
    <div class="fgsap-content">
      <div class="fgsap-brand">
        <a href="/" class="fgsap-logo-mark" aria-label="Space Solution home">
          <LogoMark />
        </a>
        <div class="fgsap-brand-copy">
          <a href="/" class="fgsap-logo-text" aria-label="Space Solution home">
            <span class="fgsap-logo-name">SPACE SOLUTION</span>
            <span class="fgsap-logo-tag">Interiors, elevated end to end.</span>
            <span class="fgsap-logo-sub">
              End-to-end interiors — we design, furnish, and hand over homes and workplaces across Mysuru, built to last.
            </span>
          </a>
          <div class="fgsap-connect">
            <div class="fgsap-social">
              <a href={SITE.social.instagram} target="_blank" rel="noopener noreferrer" aria-label="Instagram">
                <Icon name="instagram" />
              </a>
              <a href={SITE.social.facebook} target="_blank" rel="noopener noreferrer" aria-label="Facebook">
                <Icon name="facebook" />
              </a>
              <a href={SITE.social.linkedin} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
                <Icon name="linkedin" />
              </a>
              <a href={SITE.social.youtube} target="_blank" rel="noopener noreferrer" aria-label="YouTube">
                <Icon name="youtube" />
              </a>
            </div>
          </div>
        </div>
      </div>

      <div class="fgsap-nav">
        {
          FOOTER_BLUEPRINT_COLUMNS.map((col) => {
            const slug = col.title.toLowerCase().replace(/\s+/g, '-');
            return (
            <div class="fgsap-col" data-fgsap-accordion>
              <div class="fgsap-col-grid">
                <h4>
                  <button
                    type="button"
                    class="fgsap-col-toggle"
                    id={`fgsap-toggle-${slug}`}
                    aria-expanded="true"
                    aria-controls={`fgsap-links-${slug}`}
                  >
                    <span class="fgsap-col-toggle-label">{col.title}</span>
                    <span class="fgsap-col-toggle-icon" aria-hidden="true"></span>
                  </button>
                </h4>
                <ul id={`fgsap-links-${slug}`}>
                  {col.links.map((link) => (
                    <li>
                      <a href={link.href} class="fgsap-link">
                        <span class="fgsap-link-label">{link.label}</span>
                        <span class="fgsap-link-arrow" aria-hidden="true">
                          <Icon name="arrow-right" />
                        </span>
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
              <div class="fgsap-col-inline">
                <h4 class="fgsap-col-inline-heading">{col.title}</h4>
                <div class="fgsap-col-inline-links">
                  {
                    col.links.map((link, index) => (
                      <a href={link.href} class="fgsap-link fgsap-link--inline">
                        <span class="fgsap-link-label">{link.label}</span>
                        {index < col.links.length - 1 && (
                          <span class="fgsap-inline-sep" aria-hidden="true"> ·</span>
                        )}
                      </a>
                    ))
                  }
                </div>
              </div>
            </div>
            );
          })
        }
      </div>
    </div>
  </div>

  <div class="fgsap-stage" aria-label="Browse our interior services">
    <div class="fgsap-track" data-fgsap-track>
      {
        trackObjects.map((obj) => (
          <a
            href={obj.href}
            class="fgsap-object"
            data-fgsap-object={obj.id}
            data-rotate={obj.rotate}
            data-lift={obj.lift}
            style={`width:${obj.width}px; --fgsap-rotate:${obj.rotate}deg; --fgsap-lift:${obj.lift}px`}
          >
            <img
              class="fgsap-object-img"
              src={obj.src}
              alt={altFromPublicImage(obj.src)}
              width={obj.width}
              height={Math.round(obj.width * 0.75)}
              loading="eager"
              decoding="async"
              draggable="false"
            />
            <span class="fgsap-object-caption">
              <span class="fgsap-object-label">{obj.shortLabel}</span>
              <span class="fgsap-object-arrow" aria-hidden="true">
                <Icon name="arrow-right" />
              </span>
            </span>
          </a>
        ))
      }
    </div>
  </div>
</footer>
