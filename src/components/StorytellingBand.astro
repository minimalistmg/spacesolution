---
/**
 * Container Store–style storytelling gray boxes.
 * Light gray panels, stroke icons, lowercase copy, underlined learn-more.
 */
export interface StoryCard {
  icon: 'door-box' | 'craft' | 'truck' | 'price';
  title: string;
  description: string;
  href: string;
}

interface Props {
  heading?: string;
  cards?: StoryCard[];
}

const {
  heading = 'we are with you end to end',
  cards = [
    {
      icon: 'door-box',
      title: 'delivered the way you want it',
      description: 'turnkey handover - or phased install if your timeline needs it',
      href: '/turnkey-fitout',
    },
    {
      icon: 'craft',
      title: 'made in our factory',
      description: 'in-house joinery for tighter quality, finishes, and lead times',
      href: '/about',
    },
    {
      icon: 'truck',
      title: 'on-site when promised',
      description: 'factory production and installation planned as one schedule',
      href: '/portfolio',
    },
    {
      icon: 'price',
      title: 'clear pricing, no surprises',
      description: 'scoped quotes so you know the investment before we start',
      href: '/contact',
    },
  ],
} = Astro.props;
---

<section class="story-band" aria-label={heading}>
  <div class="container">
    <h2 class="story-band-heading fade-up">{heading}</h2>

    <div class="story-band-grid">
      {
        cards.map((card) => (
          <article class="story-card fade-up">
            <div class="story-card-icon" aria-hidden="true">
              {card.icon === 'door-box' && (
                <svg viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M26 12 H48 V52 H26 Z" />
                  <path d="M26 12 L14 20 V52 H26" />
                  <circle cx="42" cy="33" r="1.5" fill="currentColor" stroke="none" />
                  <rect x="6" y="38" width="16" height="14" />
                  <path d="M10 38 V34 H18 V38" />
                </svg>
              )}
              {card.icon === 'craft' && (
                <svg viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="34" y="10" width="16" height="26" rx="1" />
                  <path d="M38 16 H46" />
                  <path d="M38 20 H44" />
                  <path d="M18 50 C18 40 24 36 32 36 H40 V28 C40 24 44 22 48 26" />
                  <path d="M22 50 H50" />
                  <path d="M26 50 V56" />
                  <path d="M44 50 V56" />
                </svg>
              )}
              {card.icon === 'truck' && (
                <svg viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="4" y="20" width="36" height="24" />
                  <path d="M40 28 H52 L58 36 V44 H40 Z" />
                  <circle cx="16" cy="48" r="4.5" />
                  <circle cx="48" cy="48" r="4.5" />
                  <path d="M12 32 H32" />
                  <path d="M12 36 H28" />
                </svg>
              )}
              {card.icon === 'price' && (
                <svg viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="32" cy="32" r="11" />
                  <path d="M32 24 V40" />
                  <path d="M28 27 H33.5 C35.4 27 37 28.6 37 30.5 S35.4 34 33.5 34 H30.5 C28.6 34 27 35.6 27 37.5 S28.6 41 30.5 41 H36" />
                  <path d="M46 14 A22 22 0 0 1 54 34" />
                  <path d="M18 50 A22 22 0 0 1 10 30" />
                  <path d="M50 10 L46 14 L52 16" />
                  <path d="M14 54 L18 50 L12 48" />
                </svg>
              )}
            </div>

            <h3 class="story-card-title">{card.title}</h3>
            <p class="story-card-desc">{card.description}</p>
            <a class="story-card-link" href={card.href}>learn more</a>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style is:global>
  .story-band {
    padding: clamp(64px, 8vw, 96px) 0;
    background: #fff;
  }

  .story-band-heading {
    margin: 0 0 28px;
    font-family: var(--font);
    font-size: clamp(28px, 3.4vw, 40px);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.15;
    color: #111;
    text-transform: lowercase;
  }

  .story-band-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 16px;
  }

  .story-card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    min-height: 280px;
    padding: 28px 24px 24px;
    background: #f2f2f2;
    border-radius: 0;
    text-align: left;
  }

  .story-card-icon {
    width: 56px;
    height: 56px;
    margin-bottom: 22px;
    color: #111;
  }

  .story-card-icon svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  .story-card-title {
    margin: 0 0 12px;
    font-family: var(--font);
    font-size: clamp(18px, 1.6vw, 22px);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.2;
    color: #111;
    text-transform: lowercase;
  }

  .story-card-desc {
    margin: 0 0 auto;
    font-family: var(--font);
    font-size: 14px;
    font-weight: 400;
    line-height: 1.45;
    color: #111;
    text-transform: lowercase;
    padding-bottom: 28px;
  }

  .story-card-link {
    font-family: var(--font);
    font-size: 14px;
    font-weight: 700;
    color: #111;
    text-decoration: underline;
    text-underline-offset: 3px;
    text-transform: lowercase;
  }

  .story-card-link:hover {
    opacity: 0.7;
  }

  @media (max-width: 1023px) {
    .story-band-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    .story-band-grid {
      grid-template-columns: 1fr;
    }

    .story-card {
      min-height: 0;
    }
  }
</style>
