---
import Icon from './Icon.astro';
import { contactFormServiceOptions } from '../data/contactFormServices';
import '../styles/contact-floating-form.css';

interface Props {
  formId: string;
  defaultService?: string;
}

const { formId, defaultService = 'Space Planning' } = Astro.props;
---

<form id={formId} class="floating-contact-form enquiry-form" data-source="contact" novalidate>
  <div class="floating-contact-form-group">
    <label for={`${formId}-name`}>Your Name</label>
    <input id={`${formId}-name`} type="text" name="name" placeholder="Your Name" autocomplete="name" />
  </div>

  <div class="floating-contact-form-group">
    <label for={`${formId}-email`}>Email Address</label>
    <input
      id={`${formId}-email`}
      type="email"
      name="email"
      placeholder="you@example.com"
      autocomplete="email"
      inputmode="email"
    />
  </div>

  <div class="floating-contact-form-group">
    <label for={`${formId}-phone`}>Phone Number</label>
    <div class="floating-contact-phone">
      <input type="hidden" name="country" value="+91" />
      <span class="floating-contact-phone-code" aria-hidden="true">+91</span>
      <input
        id={`${formId}-phone`}
        type="tel"
        name="phone"
        placeholder="98765 43210"
        autocomplete="tel"
        inputmode="tel"
      />
    </div>
  </div>

  <fieldset class="floating-contact-form-group floating-contact-services">
    <legend>Select Service</legend>
    <div class="floating-contact-service-grid">
      {
        contactFormServiceOptions.map((option) => (
          <label class="floating-contact-service">
            <input
              type="radio"
              name="services"
              value={option.value}
              checked={option.value === defaultService}
            />
            <span class="floating-contact-service-card">
              <Icon name={option.icon} />
              <span>{option.label}</span>
            </span>
          </label>
        ))
      }
    </div>
  </fieldset>

  <div class="floating-contact-form-group">
    <label for={`${formId}-message`}>Tell Us About Your Project</label>
    <textarea
      id={`${formId}-message`}
      name="message"
      rows="4"
      placeholder="We're looking to redesign our 3BHK apartment with a modern minimal aesthetic."
    ></textarea>
    <p class="floating-contact-form-note">
      Share a few details about your project and our team will get back to you shortly.
    </p>
  </div>

  <button type="submit" class="floating-contact-form-submit">Send Enquiry</button>
  <p class="form-feedback" aria-live="polite"></p>
</form>
