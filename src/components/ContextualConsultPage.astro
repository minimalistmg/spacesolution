---
import MenuIcon from './MenuIcon.astro';
import ConsultInterestField from './ConsultInterestField.astro';
import ConsultFormFields from './ConsultFormFields.astro';
import {
  buildConsultBreadcrumbHtml,
  resolveConsultPreselect,
  type ConsultFormConfig,
} from '../data/consultFormConfigs';
import { applyConsultInterestContext } from '../data/consultInterestContext';
import { SITE } from '../data/site';
import '../styles/contact-floating-form.css';
import '../styles/home-3d-consult.css';

interface Props {
  config: ConsultFormConfig;
  pathname?: string;
  searchParams?: URLSearchParams;
}

const { config, pathname = Astro.url.pathname, searchParams = Astro.url.searchParams } = Astro.props;

const preselected = resolveConsultPreselect(config, pathname, searchParams);
const view = applyConsultInterestContext(config, preselected);
const formId = `consult-form-${view.kind}`;
const phoneLabel = SITE.phones[0].replace(/^(\+91)(\d{5})(\d{5})$/, '$1 $2 $3');
const whatsappHref = `https://wa.me/${SITE.phones[0].replace('+', '')}`;
const breadcrumbHtml = buildConsultBreadcrumbHtml(view.breadcrumb);
---

<section class="h3d-page">
  <form
    id={formId}
    class="container h3d-panes enquiry-form"
    data-source={view.source}
    data-whatsapp={whatsappHref}
    novalidate
  >
    <input type="hidden" name="category" value={view.category} />
    <div class="h3d-pane h3d-pane--copy">
      <nav class="h3d-breadcrumb" aria-label="Breadcrumb" set:html={breadcrumbHtml} />
      <p class="h3d-kicker">{view.kicker}</p>
      <h1 class="h3d-title">
        {view.titleBefore}
        {view.titleEm ? <em>{view.titleEm}</em> : null}
        {view.titleAfter}
      </h1>
      <p class="h3d-lead">{view.lead}</p>
      <ol class="h3d-steps">
        {
          view.steps.map((step, index) => (
            <li class="h3d-step">
              <span class="h3d-step-num">{index + 1}</span>
              <div>
                <h3>{step.title}</h3>
                <p>{step.description}</p>
              </div>
            </li>
          ))
        }
      </ol>
      <div class="h3d-contact-row">
        <a href={`tel:${SITE.phones[0]}`} class="btn h3d-btn-outline">
          <MenuIcon name="phone" />
          {phoneLabel}
        </a>
        <a href={whatsappHref} class="btn h3d-btn-outline" target="_blank" rel="noopener noreferrer">
          <MenuIcon name="whatsapp-logo" />
          WhatsApp
        </a>
      </div>
    </div>

    <div class="h3d-pane h3d-pane--form">
      <div class:list={['h3d-form-card', { 'h3d-form-card--with-extras': view.extraFields?.length }]}>
        <ConsultInterestField formId={formId} interest={view.interest} preselected={preselected} />
        <ConsultFormFields
          formId={formId}
          compact
          messagePlaceholder={view.messagePlaceholder}
          messageNote={view.messageNote}
          submitLabel={view.submitLabel}
          extraFields={view.extraFields}
        />
      </div>
    </div>
  </form>
</section>

<script is:inline src="/js/h3d-form-fit.js" defer></script>

{
  view.interest.fullHomeSync && (
    <script is:inline>
      (function () {
        document.querySelectorAll('.h3d-rooms').forEach(function (fieldset) {
          var full = fieldset.querySelector('[data-full-home="true"]');
          var rooms = Array.prototype.slice.call(
            fieldset.querySelectorAll('[data-room-id]:not([data-full-home])'),
          );
          if (!full) return;

          full.addEventListener('change', function () {
            rooms.forEach(function (input) {
              input.checked = full.checked;
            });
          });

          rooms.forEach(function (input) {
            input.addEventListener('change', function () {
              if (!input.checked) full.checked = false;
              else if (rooms.every(function (room) { return room.checked; })) full.checked = true;
            });
          });
        });
      })();
    </script>
  )
}
