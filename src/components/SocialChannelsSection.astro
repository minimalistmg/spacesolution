---
import Icon from './Icon.astro';
import { SITE } from '../data/site';
import { socialChannelItems, socialPlatformMeta } from '../data/socialChannels';
import { altFromPublicImage } from '../lib/publicImage';

const loopItems = [...socialChannelItems, ...socialChannelItems];
const platforms = [
  { platform: 'instagram' as const, href: SITE.social.instagram },
  { platform: 'facebook' as const, href: SITE.social.facebook },
  { platform: 'youtube' as const, href: SITE.social.youtube },
];
---

<section class="social-cinema" aria-labelledby="social-channels-title">
  <div class="container social-cinema-header">
    <p class="social-cinema-label">On social</p>
    <h2 class="social-cinema-title" id="social-channels-title">Spaces, always in motion</h2>
  </div>

  <div class="social-cinema-marquee">
    <div class="social-cinema-row">
      <div class="social-cinema-track" aria-label="Social videos from Instagram, Facebook, and YouTube">
        {
          loopItems.map((item, index) => {
            const isDuplicate = index >= socialChannelItems.length;
            const meta = socialPlatformMeta[item.platform];
            return (
              <a
                class="social-cinema-reel"
                href={item.href}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`${item.title} on ${meta.label}`}
                tabindex={isDuplicate ? -1 : undefined}
                aria-hidden={isDuplicate ? 'true' : undefined}
              >
                <img
                  src={item.image}
                  alt={isDuplicate ? '' : altFromPublicImage(item.image)}
                  width="200"
                  height="356"
                  loading="lazy"
                />
                <span class="social-cinema-platform">
                  <Icon name={meta.icon} />
                  <span class="social-cinema-sr">{meta.label}</span>
                </span>
                <span class="social-cinema-play" aria-hidden="true">
                  <svg viewBox="0 0 48 48" fill="none">
                    <circle cx="24" cy="24" r="23" stroke="currentColor" stroke-width="1.5"></circle>
                    <path d="M20 16l14 8-14 8V16z" fill="#fff"></path>
                  </svg>
                </span>
              </a>
            );
          })
        }
      </div>
    </div>
  </div>

  <div class="container social-cinema-actions">
    {
      platforms.map(({ platform, href }) => (
        <a
          class="btn btn-gold-outline"
          href={href}
          target="_blank"
          rel="noopener noreferrer"
        >
          <Icon name={socialPlatformMeta[platform].icon} />
          {socialPlatformMeta[platform].label}
        </a>
      ))
    }
  </div>
</section>
